{
    "_comment": "Pelican/Pterodactyl egg for Leaf (Paper fork) - https://www.leafmc.one",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-10-02T09:00:00+02:00",
    "name": "Leaf",
    "author": "contact@hiorcraft.dev",
    "description": "Leaf is an open-source, high-performance server software designed for Minecraft and built on top of Paper. By focusing on performance, vanilla behavior and stability, Leaf aims to provide a fast and highly customizable server that stays fully compatible with Spigot and Paper plugins.",
    "image": "data:image/png;base64,",
    "features": [
        "eula",
        "java_version",
        "pid_limit"
    ],
    "docker_images": {
        "Java 25": "ghcr.io/pelican-eggs/yolks:java_25",
        "Java 21": "ghcr.io/pelican-eggs/yolks:java_21",
        "Java 17": "ghcr.io/pelican-eggs/yolks:java_17",
        "Java 16": "ghcr.io/pelican-eggs/yolks:java_16",
        "Java 11": "ghcr.io/pelican-eggs/yolks:java_11",
        "Java 8": "ghcr.io/pelican-eggs/yolks:java_8"
    },
    "file_denylist": [],
    "startup": "java -Xms128M -XX:MaxRAMPercentage=95.0 -Dterminal.jline=false -Dterminal.ansi=true -jar {{SERVER_JARFILE}}",
    "config": {
        "files": "{\n    \"server.properties\": {\n        \"parser\": \"properties\",\n        \"find\": {\n            \"server-ip\": \"0.0.0.0\",\n            \"server-port\": \"{{server.allocations.default.port}}\",\n            \"query.port\": \"{{server.allocations.default.port}}\"\n        }\n    }\n}",
        "startup": "{\n    \"done\": \")! For help, type \"\n}",
        "logs": "{}",
        "stop": "stop"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Leaf installation script for Pelican\n# Server files are located in /mnt/server\n\nPROJECT=leaf\nAPI_URL=\"https://api.leafmc.one/v2/projects/${PROJECT}\"\n\nif ! command -v jq > /dev/null 2>&1 || ! command -v curl > /dev/null 2>&1; then\n  apt update && apt install -y curl jq\nfi\n\nmkdir -p /mnt/server\ncd /mnt/server || exit 1\n\n# Resolve Minecraft version\nif [ -z \"${MINECRAFT_VERSION}\" ] || [ \"${MINECRAFT_VERSION}\" == \"latest\" ]; then\n  MINECRAFT_VERSION=$(curl -s \"${API_URL}\" | jq -r '.versions[-1]')\n  echo \"Latest Minecraft version: ${MINECRAFT_VERSION}\"\nfi\n\nVERSION_INFO=$(curl -s \"${API_URL}/versions/${MINECRAFT_VERSION}\")\nif [ -z \"${VERSION_INFO}\" ] || [ \"$(echo \"${VERSION_INFO}\" | jq -r '.builds | length' 2>/dev/null)\" == \"0\" ] || [ \"$(echo \"${VERSION_INFO}\" | jq -r '.builds' 2>/dev/null)\" == \"null\" ]; then\n  echo \"ERROR: Version ${MINECRAFT_VERSION} was not found for Leaf.\"\n  echo \"Available versions:\"\n  curl -s \"${API_URL}\" | jq -r '.versions[]'\n  exit 1\nfi\n\n# Resolve build\nif [ -z \"${BUILD_NUMBER}\" ] || [ \"${BUILD_NUMBER}\" == \"latest\" ]; then\n  BUILD_NUMBER=$(echo \"${VERSION_INFO}\" | jq -r '.builds[-1]')\n  echo \"Latest build: ${BUILD_NUMBER}\"\nfi\n\nJAR_NAME=\"${PROJECT}-${MINECRAFT_VERSION}-${BUILD_NUMBER}.jar\"\nDOWNLOAD_URL=\"${API_URL}/versions/${MINECRAFT_VERSION}/builds/${BUILD_NUMBER}/downloads/${JAR_NAME}\"\n\necho \"Downloading: ${DOWNLOAD_URL}\"\n\nif [ -f \"${SERVER_JARFILE}\" ]; then\n  mv \"${SERVER_JARFILE}\" \"${SERVER_JARFILE}.old\"\nfi\n\nif ! curl -fL -o \"${SERVER_JARFILE}\" \"${DOWNLOAD_URL}\"; then\n  echo \"ERROR: Download failed.\"\n  [ -f \"${SERVER_JARFILE}.old\" ] && mv \"${SERVER_JARFILE}.old\" \"${SERVER_JARFILE}\"\n  exit 1\nfi\n\nrm -f \"${SERVER_JARFILE}.old\"\n\nif [ ! -f server.properties ]; then\n  echo \"server-port=25565\" > server.properties\nfi\n\n\necho \"Leaf ${MINECRAFT_VERSION} build ${BUILD_NUMBER} has been installed.\"\n",
            "container": "ghcr.io/pelican-eggs/installers:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Minecraft Version",
            "description": "The Leaf Minecraft version to install, e.g. 26.2 or 1.21.8. Use 'latest' for the newest version.",
            "env_variable": "MINECRAFT_VERSION",
            "default_value": "latest",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:20",
            "field_type": "text"
        },
        {
            "name": "Build Number",
            "description": "The Leaf build number to install. Use 'latest' for the newest build.",
            "env_variable": "BUILD_NUMBER",
            "default_value": "latest",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:20",
            "field_type": "text"
        },
        {
            "name": "Server Jar File",
            "description": "The name of the server jar file.",
            "env_variable": "SERVER_JARFILE",
            "default_value": "server.jar",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|regex:/^([\\w\\d._-]+)(\\.jar)$/",
            "field_type": "text"
        }
    ]
}