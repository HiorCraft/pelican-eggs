    "uuid": "54050b7e-6479-4d3c-9140-3220df7815b8",
    "description": "Velocity-CTD is an open-source fork of the Velocity proxy that adds built-in Redis support, a queue system, network-wide commands and performance optimizations.",
    "image": "data:image/png;base64,",
    "tags": [
        "minecraft",
        "proxy"
    ],
    "features": [
        "eula",
        "java_version",
        "pid_limit"
    ],
    "docker_images": {
        "Java 25": "ghcr.io/pelican-eggs/yolks:java_25",
        "Java 21": "ghcr.io/pelican-eggs/yolks:java_21",
        "Java 17": "ghcr.io/pelican-eggs/yolks:java_17",
        "Java 16": "ghcr.io/pelican-eggs/yolks:java_16",
        "Java 11": "ghcr.io/pelican-eggs/yolks:java_11",
        "Java 8": "ghcr.io/pelican-eggs/yolks:java_8"
    },
    "file_denylist": [],
    "startup_commands": {
        "Default": "java -Xms128M -Xmx{{SERVER_MEMORY}}M -XX:+UseG1GC -XX:G1HeapRegionSize=4M -XX:+UnlockExperimentalVMOptions -XX:+ParallelRefProcEnabled -XX:+AlwaysPreTouch -XX:MaxInlineLevel=15 -jar {{SERVER_JARFILE}}"
    },
    "config": {
        "files": "{\n    \"velocity.toml\": {\n        \"parser\": \"file\",\n        \"find\": {\n            \"bind = \": \"bind = \\\"0.0.0.0:{{server.allocations.default.port}}\\\"\"\n        }\n    }\n}",
        "startup": "{\n    \"done\": \"Done (\"\n}",
        "logs": "{}",
        "stop": "end"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Velocity-CTD installation script for Pelican\n# Server files are located in /mnt/server\n\nREPO=\"GemstoneGG/Velocity-CTD\"\nAPI_URL=\"https://api.github.com/repos/${REPO}/releases\"\n\nif ! command -v jq > /dev/null 2>&1 || ! command -v curl > /dev/null 2>&1; then\n  apt update && apt install -y curl jq\nfi\n\nmkdir -p /mnt/server\ncd /mnt/server || exit 1\n\n# Resolve release (builds are tagged as build-<number>)\nBUILD_NUMBER=\"${BUILD_NUMBER#build-}\"\nif [ -z \"${BUILD_NUMBER}\" ] || [ \"${BUILD_NUMBER}\" == \"latest\" ]; then\n  RELEASE_URL=\"${API_URL}/latest\"\nelse\n  RELEASE_URL=\"${API_URL}/tags/build-${BUILD_NUMBER}\"\nfi\n\nRELEASE_INFO=$(curl -fsSL -H \"Accept: application/vnd.github+json\" \"${RELEASE_URL}\")\nTAG=$(echo \"${RELEASE_INFO}\" | jq -r '.tag_name // empty' 2>/dev/null)\nif [ -z \"${TAG}\" ]; then\n  echo \"ERROR: Velocity-CTD build '${BUILD_NUMBER}' was not found (or the GitHub API is not reachable).\"\n  echo \"Recent builds:\"\n  curl -fsSL -H \"Accept: application/vnd.github+json\" \"${API_URL}?per_page=10\" | jq -r '.[].tag_name' 2>/dev/null\n  exit 1\nfi\necho \"Using Velocity-CTD release: ${TAG}\"\n\n# Pick the jar: bootstrap jar (recommended) or fatjar\nJARS=$(echo \"${RELEASE_INFO}\" | jq -c '[.assets[] | select(.name | test(\"^velocity-ctd-.*\\\\.jar$\"))]')\nASSET=\"\"\nif [ \"${JAR_TYPE}\" == \"fatjar\" ]; then\n  ASSET=$(echo \"${JARS}\" | jq -c '[.[] | select(.name | startswith(\"velocity-ctd-fatjar-\"))][0] // empty')\n  [ -z \"${ASSET}\" ] && echo \"WARNING: No fatjar found in ${TAG}, using the bootstrap jar instead.\"\nfi\nif [ -z \"${ASSET}\" ]; then\n  ASSET=$(echo \"${JARS}\" | jq -c '[.[] | select(.name | startswith(\"velocity-ctd-fatjar-\") | not)][0] // empty')\nfi\nif [ -z \"${ASSET}\" ]; then\n  echo \"ERROR: No jar file found in release ${TAG}.\"\n  exit 1\nfi\n\nJAR_NAME=$(echo \"${ASSET}\" | jq -r '.name')\nDOWNLOAD_URL=$(echo \"${ASSET}\" | jq -r '.browser_download_url')\nJAR_SHA256=$(echo \"${ASSET}\" | jq -r 'if ((.digest // \"\") | startswith(\"sha256:\")) then .digest[7:] else empty end')\n\necho \"Downloading: ${DOWNLOAD_URL}\"\n\n# Download to a temporary file first, so an existing jar is only replaced after a successful download\nif ! curl -fL -o \"${SERVER_JARFILE}.download\" \"${DOWNLOAD_URL}\"; then\n  echo \"ERROR: Download failed.\"\n  rm -f \"${SERVER_JARFILE}.download\"\n  exit 1\nfi\n\n# Verify checksum (provided by GitHub)\nif [ -n \"${JAR_SHA256}\" ]; then\n  if echo \"${JAR_SHA256}  ${SERVER_JARFILE}.download\" | sha256sum -c --status -; then\n    echo \"Checksum verified.\"\n  else\n    echo \"ERROR: Checksum mismatch, the downloaded file is corrupted.\"\n    rm -f \"${SERVER_JARFILE}.download\"\n    exit 1\n  fi\nfi\n\nmv -f \"${SERVER_JARFILE}.download\" \"${SERVER_JARFILE}\"\n\n# Default config of this build, so the panel can set the port before the first start\nif [ ! -f velocity.toml ]; then\n  echo \"Downloading default velocity.toml for ${TAG}\"\n  if ! curl -fsSL -o velocity.toml \"https://raw.githubusercontent.com/${REPO}/${TAG}/proxy/src/main/resources/default-velocity.toml\"; then\n    echo \"WARNING: Could not download the default config, Velocity-CTD will create it on first start.\"\n    rm -f velocity.toml\n  fi\nfi\n\necho \"Velocity-CTD ${TAG} (${JAR_NAME}) has been installed.\"\n",
            "container": "ghcr.io/pelican-eggs/installers:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "sort": 1,
            "name": "Build Number",
            "description": "The Velocity-CTD build to install, e.g. 400.\r\n\r\nUse 'latest' to always get the newest build.",
            "env_variable": "BUILD_NUMBER",
            "default_value": "latest",
            "user_viewable": true,
            "user_editable": true,
            "rules": [
                "required",
                "string",
                "max:20"
            ]
        },
        {
            "sort": 2,
            "name": "Jar Type",
            "description": "'bootstrap' (recommended) keeps the jar small and downloads its libraries once on first start.\r\n'fatjar' contains everything, but will be removed by Velocity-CTD soon.",
            "env_variable": "JAR_TYPE",
            "default_value": "bootstrap",
            "user_viewable": true,
            "user_editable": true,
            "rules": [
                "required",
                "string",
                "in:bootstrap,fatjar"
            ]
        },
        {
            "sort": 3,
            "name": "Server Jar File",
            "description": "The name of the server jar file.",
            "env_variable": "SERVER_JARFILE",
            "default_value": "velocity.jar",
            "user_viewable": true,
            "user_editable": true,
            "rules": [
                "required",
                "string",
                "max:32",
                "regex:/^([\\w\\d._-]+)(\\.jar)$/"
            ]
        }
    ]
}